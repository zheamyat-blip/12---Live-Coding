import java.util.Scanner;

public class GreatestCommonDivisor {

    // Recursive method to calculate the GCD
    public static int gcd(int a, int b) {

        // Base case: when b becomes 0, return a
        if (b == 0) {
            return a;
        }

        // Recursive case: call gcd using b and the remainder
        return gcd(b, a % b);
    }

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        System.out.print("Enter the first non-negative integer: ");
        int a = input.nextInt();

        System.out.print("Enter the second non-negative integer: ");
        int b = input.nextInt();

        // Validate negative inputs
        if (a < 0 || b < 0) {
            System.out.println("Invalid input! Negative numbers are not allowed.");
        }

        // GCD of two zeros is undefined
        else if (a == 0 && b == 0) {
            System.out.println("GCD is undefined for (0, 0).");
        }

        else {
            int result = gcd(a, b);

            System.out.println("Greatest Common Divisor: " + result);
        }

        input.close();
    }
}




